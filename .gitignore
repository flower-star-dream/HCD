# Maven 编译生成文件
/backend/**/target/maven-status/
/backend/**/target/classes/

# Maven flatten 插件生成文件
/backend/**/pom-xml-flattened

# 忽略所有 target 目录下的编译输出
/backend/**/target/
/backend/*.iml
/backend/*.class
/backend/*Test.java
/backend/**/test/
/backend/.idea/


# 忽略所有 node_modules 目录下的编译输出
frontend/**/node_modules/
frontend/**/package-lock.json
# 忽略前端构建生成文件
frontend/**/dist/
frontend/**/build/
frontend/**/.next/
frontend/**/out/

# 忽略测试覆盖率报告
coverage/

# 忽略日志文件
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 忽略IDE和编辑器生成的文件
.idea/
.vscode/
*.swp
*.swo
*~

# 忽略操作系统生成的文件
.DS_Store
Thumbs.db

# 忽略环境变量文件
.env.local
.env.*.local
.claude