# 票务服务 - 使用多阶段构建，包含SQL初始化
FROM maven:3.9-eclipse-temurin-17-alpine AS builder

# 设置工作目录
WORKDIR /app

# 复制所有源码（确保Maven可以解析完整项目结构）
COPY . .

# 下载所有依赖
RUN mvn dependency:go-offline -B

# 仅构建票务服务及其依赖
RUN mvn clean package -DskipTests -pl ticket-parent/ticket-boot -am

# 运行时镜像
FROM eclipse-temurin:17-jre-alpine

# 安装必要的工具
RUN apk add --no-cache curl mysql-client bash

# 创建应用目录
WORKDIR /app

# 复制构建的jar包
COPY --from=builder /app/ticket-parent/ticket-boot/target/*.jar app.jar

# 复制SQL文件用于运行时初始化
COPY --from=builder /app/ticket-parent/ticket-biz/src/main/resources/db/sql /app/sql

# 创建初始化脚本
RUN echo '#!/bin/bash\
echo "等待MySQL服务启动..."\
while ! mysqladmin ping -h"${DB_HOST:-hcd-mysql}" -u"${DB_USER:-root}" -p"${DB_PASSWORD:-root123}" --silent; do\
    sleep 1\
done\
\
echo "开始执行数据库初始化..."\
if [ -d "/app/sql" ]; then\
    for sql_file in /app/sql/*.sql; do\
        if [ -f "$sql_file" ]; then\
            echo "执行SQL文件: $sql_file"\
            mysql -h"${DB_HOST:-hcd-mysql}" -u"${DB_USER:-root}" -p"${DB_PASSWORD:-root123}" < "$sql_file"\
        fi\
    done\
fi\
\
echo "数据库初始化完成"\
exec java -Djava.security.egd=file:/dev/./urandom -jar -Dspring.profiles.active=${SPRING_PROFILES_ACTIVE:-docker} -Dserver.port=8083 app.jar' > /app/entrypoint.sh \
    && chmod +x /app/entrypoint.sh

# 创建日志目录
RUN mkdir -p /app/logs

# 暴露端口
EXPOSE 8083

# 启动命令
ENTRYPOINT ["/app/entrypoint.sh"]
